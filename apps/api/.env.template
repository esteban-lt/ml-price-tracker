NODE_ENV=development # development | production | test

PORT=3000

DATABASE_URL=postgresql://nudge:nudge@localhost:5432/nudge

JWT_SECRET=#Generate with: openssl rand -hex 16
JWT_EXPIRES_IN=2h

ML_CLIENT_ID=# Get from https://developers.mercadolibre.com/
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://oauth.pstmn.io/v1/callback # Must match the Redirect URI configured in the DevCenter

PRICE_REFRESH_ENABLED=true # Enables the periodic price refresh job
PRICE_REFRESH_INTERVAL_MINUTES=360 # How often the job runs (360 = every 6 hours)

CORS_ORIGIN=http://localhost:5173 # Allowed origins, comma separated. Required in production (no "*")

ADMIN_EMAILS= # Comma separated emails allowed to use admin endpoints (e.g. Mercado Libre authorization)

RESEND_API_KEY= # Get from https://resend.com/api-keys. Required in production; without it (dev only) emails are logged instead of sent
MAIL_FROM=Nudge <onboarding@resend.dev> # Sender. Required in production (must use a domain verified in Resend)
FRONTEND_URL=http://localhost:5173 # Frontend base URL used in email links. Required in production
VERIFICATION_CODE_SECRET=#Generate with: openssl rand -hex 32. Required in production (min 32 chars)
